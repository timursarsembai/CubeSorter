<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Основной контент -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/child_gradient_blue"
        android:padding="12dp">

        <!-- Информация об уровне, времени и ходах -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="#FFFFFFFF"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:padding="12dp">

                <!-- Кнопка меню -->
                <ImageButton
                    android:id="@+id/buttonOpenDrawer"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/menu"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="#455A64"
                    android:layout_marginEnd="8dp" />

                <!-- Уровень -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/level"
                        tools:text="Level"/>
                    <TextView
                        android:id="@+id/textLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="1"
                        android:textStyle="bold"
                        android:textColor="#00838F"
                        android:textSize="18sp"/>
                </LinearLayout>

                <!-- Таймер -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/time"
                        tools:text="Time"/>
                    <TextView
                        android:id="@+id/textTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/time_zero_tenth"
                        tools:text="00:00.0"
                        android:textStyle="bold"
                        android:textColor="#455A64"
                        android:textSize="18sp"/>
                </LinearLayout>

                <!-- Ходы -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/moves"
                        tools:text="Moves"/>
                    <TextView
                        android:id="@+id/textMoves"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:textSize="18sp"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Панель жизней над игровым полем: сердца по центру + сложность слева -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/textDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:textColor="#455A64"
                android:textSize="16sp"
                tools:text="😊 Easy"/>

            <TextView
                android:id="@+id/textLivesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="#D32F2F"
                android:textSize="18sp"
                tools:text="❤️❤️❤️❤️❤️"/>
        </FrameLayout>

        <!-- Игровое поле -->
        <com.timursarsembayev.cubesorter.SorterGameView
            android:id="@+id/sorterGameView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"/>

        <!-- Контейнер под баннер AdMob (сам AdView создаём программно; скрыт до загрузки) -->
        <FrameLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Левое выдвижное меню: заменено на include -->
    <include
        layout="@layout/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
